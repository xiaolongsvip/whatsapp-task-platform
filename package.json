{
  "name": "whatsapp-task-platform",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "pnpm dev:local",
    "dev:local": "concurrently --kill-others --names WEB,ADMIN,API \"pnpm dev:web\" \"pnpm dev:admin\" \"pnpm dev:api\"",
    "dev:web": "dotenv -e .env -- pnpm --filter @wtp/web dev",
    "dev:admin": "dotenv -e .env -- pnpm --filter @wtp/admin dev",
    "dev:api": "dotenv -e .env -- pnpm --filter @wtp/api start:dev",
    "build": "pnpm --filter @wtp/web build && pnpm --filter @wtp/admin build && pnpm --filter @wtp/api build",
    "typecheck": "pnpm --filter @wtp/web typecheck && pnpm --filter @wtp/admin typecheck && pnpm --filter @wtp/api typecheck",
    "lint": "pnpm --filter @wtp/web lint && pnpm --filter @wtp/admin lint && pnpm --filter @wtp/api lint",
    "db:generate": "dotenv -e .env -- pnpm --filter @wtp/database db:generate",
    "db:validate": "dotenv -e .env -- pnpm --filter @wtp/database db:validate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @wtp/database db:migrate",
    "db:studio": "dotenv -e .env -- pnpm --filter @wtp/database db:studio",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv-cli": "^8.0.0",
    "typescript": "^5.8.3"
  }
}
