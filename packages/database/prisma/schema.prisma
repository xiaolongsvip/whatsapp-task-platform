generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum TaskStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
}

enum ClaimStatus {
  CLAIMED
  IN_PROGRESS
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum SubmissionStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum ReviewDecision {
  APPROVE
  REJECT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  REQUESTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  PROCESSING
  PAID
  FAILED
  CANCELLED
}

enum PayoutAccountStatus {
  ACTIVE
  DISABLED
}

enum PaymentFlow {
  DEPOSIT
  PAYOUT
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum ContactNumberStatus {
  AVAILABLE
  ASSIGNED
  USED
  BLOCKED
}

enum ContactConsentStatus {
  UNKNOWN
  GRANTED
  REVOKED
}

enum ContactAssignmentStatus {
  ASSIGNED
  RELEASED
  COMPLETED
}

enum TaskSlotStatus {
  AVAILABLE
  ASSIGNED
  USED
  VOIDED
}

enum AdminStatus {
  ACTIVE
  DISABLED
}

enum DeviceStatus {
  ACTIVE
  BLOCKED
}

enum WalletHoldStatus {
  ACTIVE
  RELEASED
  CAPTURED
}

enum WalletHoldEventType {
  FROZEN
  RELEASED
  CAPTURED
}

enum AiReviewJobStatus {
  PENDING
  PROCESSING
  RETRY
  COMPLETED
  NEEDS_REVIEW
}

model User {
  id                    String                 @id @default(uuid()) @db.Uuid
  phone                 String                 @unique
  referralCode           String                 @unique @map("referral_code")
  passwordHash          String                 @map("password_hash")
  status                UserStatus             @default(PENDING)
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  profile               UserProfile?
  invitedBy             ReferralEdge?           @relation("Invitee")
  invitees              ReferralEdge[]          @relation("Inviter")
  ancestors             ReferralAncestor[]      @relation("Descendant")
  descendants           ReferralAncestor[]      @relation("Ancestor")
  claims                TaskClaim[]
  wallets               Wallet[]
  adminIdentity         AdminUser?
  sessions              AuthSession[]
  contactAssignments    ContactAssignment[]
  payoutAccounts        PayoutAccount[]
  paymentTransactions   PaymentTransaction[]
  devices               UserDevice[]

  @@index([status, createdAt])
  @@map("users")
}


model UserDevice {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @map("user_id") @db.Uuid
  deviceIdentifier   String             @map("device_identifier")
  manufacturer       String?
  model              String
  androidVersion     String?            @map("android_version")
  sdkInt             Int?               @map("sdk_int")
  appVersion         String             @map("app_version")
  firstSeenAt        DateTime           @default(now()) @map("first_seen_at")
  lastSeenAt         DateTime           @default(now()) @map("last_seen_at")
  status             DeviceStatus       @default(ACTIVE)
  isFlagged          Boolean            @default(false) @map("is_flagged")
  flagReason         String?            @map("flag_reason")
  statusUpdatedAt    DateTime           @default(now()) @map("status_updated_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  events             UserDeviceEvent[]

  @@unique([userId, deviceIdentifier])
  @@index([userId, lastSeenAt])
  @@index([deviceIdentifier])
  @@index([status, isFlagged])
  @@map("user_devices")
}

model UserDeviceEvent {
  id               String     @id @default(uuid()) @db.Uuid
  deviceId         String     @map("device_id") @db.Uuid
  eventType        String     @map("event_type")
  manufacturer     String?
  model            String
  androidVersion   String?    @map("android_version")
  appVersion       String     @map("app_version")
  sdkInt           Int?       @map("sdk_int")
  actorId          String?    @map("actor_id") @db.Uuid
  reason           String?    @db.Text
  createdAt        DateTime   @default(now()) @map("created_at")
  device           UserDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("user_device_events")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("auth_sessions")
}

model UserProfile {
  userId       String   @id @map("user_id") @db.Uuid
  displayName  String?  @map("display_name")
  locale       String   @default("en")
  timezone     String   @default("UTC")
  dailyTaskLimit Int?    @map("daily_task_limit")
  minClaimIntervalSeconds Int? @map("min_claim_interval_seconds")
  reputationScore Int    @default(60) @map("reputation_score")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

model ReferralEdge {
  id            String   @id @default(uuid()) @db.Uuid
  inviteeUserId String   @unique @map("invitee_user_id") @db.Uuid
  inviterUserId String   @map("inviter_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  invitee       User     @relation("Invitee", fields: [inviteeUserId], references: [id], onDelete: Restrict)
  inviter       User     @relation("Inviter", fields: [inviterUserId], references: [id], onDelete: Restrict)

  @@index([inviterUserId, createdAt])
  @@map("referral_edges")
}

model ReferralAncestor {
  descendantUserId String   @map("descendant_user_id") @db.Uuid
  ancestorUserId   String   @map("ancestor_user_id") @db.Uuid
  depth            Int
  createdAt        DateTime @default(now()) @map("created_at")
  descendant       User     @relation("Descendant", fields: [descendantUserId], references: [id], onDelete: Cascade)
  ancestor         User     @relation("Ancestor", fields: [ancestorUserId], references: [id], onDelete: Restrict)

  @@id([descendantUserId, depth])
  @@unique([descendantUserId, ancestorUserId])
  @@index([ancestorUserId, depth])
  @@map("referral_ancestors")
}

model ContactImportBatch {
  id                String          @id @default(uuid()) @db.Uuid
  fileName          String?         @map("file_name")
  totalRows         Int             @default(0) @map("total_rows")
  importedCount     Int             @default(0) @map("imported_count")
  duplicateCount    Int             @default(0) @map("duplicate_count")
  invalidCount      Int             @default(0) @map("invalid_count")
  createdByAdminId  String?         @map("created_by_admin_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  createdBy         AdminUser?      @relation(fields: [createdByAdminId], references: [id], onDelete: Restrict)
  numbers           ContactNumber[]

  @@index([createdAt])
  @@map("contact_import_batches")
}

model ContactNumber {
  id              String                @id @default(uuid()) @db.Uuid
  phoneE164       String                @unique @map("phone_e164")
  countryCode     String?               @map("country_code") @db.Char(2)
  countryName     String?               @map("country_name") @db.VarChar(100)
  status          ContactNumberStatus   @default(AVAILABLE)
  consentStatus   ContactConsentStatus  @default(UNKNOWN) @map("consent_status")
  consentSource   String?               @map("consent_source") @db.Text
  consentedAt     DateTime?             @map("consented_at")
  revokedAt       DateTime?             @map("revoked_at")
  importBatchId   String?               @map("import_batch_id") @db.Uuid
  importOrder     BigInt                @unique @default(autoincrement()) @map("import_order")
  importedAt      DateTime              @default(now()) @map("imported_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  importBatch     ContactImportBatch?   @relation(fields: [importBatchId], references: [id], onDelete: Restrict)
  assignments     ContactAssignment[]
  taskSlots       TaskSlot[]
  consentEvents   ContactConsentEvent[]

  @@index([status, consentStatus, importOrder])
  @@index([countryCode, importOrder])
  @@index([importBatchId, importOrder])
  @@map("contact_numbers")
}

model ContactConsentEvent {
  id              String                @id @default(uuid()) @db.Uuid
  contactNumberId String                @map("contact_number_id") @db.Uuid
  status          ContactConsentStatus
  source          String?               @db.Text
  recordedAt      DateTime              @default(now()) @map("recorded_at")
  contactNumber   ContactNumber         @relation(fields: [contactNumberId], references: [id], onDelete: Restrict)

  @@index([contactNumberId, recordedAt])
  @@map("contact_consent_events")
}

model TaskSlot {
  id              String         @id @default(uuid()) @db.Uuid
  taskId          String         @map("task_id") @db.Uuid
  contactNumberId String         @unique @map("contact_number_id") @db.Uuid
  claimId         String?        @unique @map("claim_id") @db.Uuid
  status          TaskSlotStatus @default(AVAILABLE)
  assignedAt      DateTime?      @map("assigned_at")
  releasedAt      DateTime?      @map("released_at")
  usedAt          DateTime?      @map("used_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  task            Task           @relation(fields: [taskId], references: [id], onDelete: Restrict)
  contactNumber   ContactNumber  @relation(fields: [contactNumberId], references: [id], onDelete: Restrict)
  claim           TaskClaim?     @relation(fields: [claimId], references: [id], onDelete: Restrict)

  @@index([taskId, status, createdAt])
  @@map("task_slots")
}

model ContactAssignment {
  id              String                  @id @default(uuid()) @db.Uuid
  contactNumberId String                  @map("contact_number_id") @db.Uuid
  claimId         String                  @unique @map("claim_id") @db.Uuid
  userId          String                  @map("user_id") @db.Uuid
  status          ContactAssignmentStatus @default(ASSIGNED)
  assignedAt      DateTime                @default(now()) @map("assigned_at")
  releasedAt      DateTime?               @map("released_at")
  completedAt     DateTime?               @map("completed_at")
  contactNumber   ContactNumber           @relation(fields: [contactNumberId], references: [id], onDelete: Restrict)
  claim           TaskClaim               @relation(fields: [claimId], references: [id], onDelete: Restrict)
  user            User                    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([contactNumberId, status, assignedAt])
  @@index([userId, assignedAt])
  @@map("contact_assignments")
}

model Task {
  id           String      @id @default(uuid()) @db.Uuid
  title        String
  description  String      @db.Text
  category     String
  groupId      String?     @map("group_id") @db.Uuid
  group        TaskGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  status       TaskStatus  @default(DRAFT)
  rewardMinor  BigInt      @map("reward_minor")
  currency     String      @db.Char(3)
  capacity          Int?
  claimedCount      Int         @default(0) @map("claimed_count")
  startsAt          DateTime?   @map("starts_at")
  endsAt            DateTime?   @map("ends_at")
  messageTemplate   String?     @map("message_template") @db.Text
  linkUrl           String?     @map("link_url") @db.Text
  previewTitle      String?     @map("preview_title")
  previewDescription String?    @map("preview_description") @db.Text
  previewImageUrl   String?     @map("preview_image_url") @db.Text
  policyVersion     Int         @default(1) @map("policy_version")
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")
  claims       TaskClaim[]
  slots        TaskSlot[]

  @@index([status, startsAt, endsAt])
  @@index([groupId])
  @@map("tasks")
}


model TaskGroup {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  tasks       Task[]

  @@map("task_groups")
}

model TaskClaim {
  id             String      @id @default(uuid()) @db.Uuid
  taskId         String      @map("task_id") @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  status         ClaimStatus @default(CLAIMED)
  claimedAt      DateTime    @default(now()) @map("claimed_at")
  expiresAt      DateTime?   @map("expires_at")
  idempotencyKey String      @unique @map("idempotency_key")
  task           Task        @relation(fields: [taskId], references: [id], onDelete: Restrict)
  user           User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  submissions    TaskSubmission[]
  contactAssignment ContactAssignment?
  taskSlot       TaskSlot?

  @@index([taskId, userId, status])
  @@index([userId, status, claimedAt])
  @@index([taskId, status])
  @@map("task_claims")
}

model TaskSubmission {
  id             String           @id @default(uuid()) @db.Uuid
  claimId        String           @map("claim_id") @db.Uuid
  objectKey      String           @map("object_key")
  note           String?          @db.Text
  status         SubmissionStatus @default(SUBMITTED)
  idempotencyKey String?          @unique @map("idempotency_key")
  mimeType       String?          @map("mime_type")
  sizeBytes      Int?             @map("size_bytes")
  originalName   String?          @map("original_name")
  submittedAt    DateTime         @default(now()) @map("submitted_at")
  claim          TaskClaim        @relation(fields: [claimId], references: [id], onDelete: Restrict)
  reviews        TaskReview[]
  aiReviewJob    AiReviewJob?

  @@index([status, submittedAt])
  @@index([claimId, submittedAt])
  @@map("task_submissions")
}

model AiReviewJob {
  id             String           @id @default(uuid()) @db.Uuid
  submissionId   String           @unique @map("submission_id") @db.Uuid
  status         AiReviewJobStatus @default(PENDING)
  attemptCount   Int              @default(0) @map("attempt_count")
  nextAttemptAt  DateTime         @default(now()) @map("next_attempt_at")
  lockedAt       DateTime?        @map("locked_at")
  lastError      String?          @map("last_error") @db.Text
  decision       String?
  confidence     Float?
  reason         String?          @db.Text
  extractedText  String?          @map("extracted_text") @db.Text
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  submission     TaskSubmission   @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  @@index([status, nextAttemptAt, createdAt])
  @@map("ai_review_jobs")
}

model TaskReview {
  id                String         @id @default(uuid()) @db.Uuid
  submissionId      String         @map("submission_id") @db.Uuid
  reviewerAdminId   String?        @map("reviewer_admin_id") @db.Uuid
  decision          ReviewDecision
  reason            String?        @db.Text
  reviewedAt        DateTime       @default(now()) @map("reviewed_at")
  submission        TaskSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)
  reviewer          AdminUser?     @relation(fields: [reviewerAdminId], references: [id], onDelete: Restrict)

  @@index([submissionId, reviewedAt])
  @@map("task_reviews")
}

model Wallet {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  currency  String            @db.Char(3)
  createdAt DateTime          @default(now()) @map("created_at")
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  entries   LedgerEntry[]
  withdrawals WithdrawalRequest[]
  paymentTransactions PaymentTransaction[]
  holds WalletHold[]

  @@unique([userId, currency])
  @@map("wallets")
}

model LedgerEntry {
  id             String          @id @default(uuid()) @db.Uuid
  walletId       String          @map("wallet_id") @db.Uuid
  sourceType     String          @map("source_type")
  sourceId       String          @map("source_id")
  direction      LedgerDirection
  amountMinor    BigInt          @map("amount_minor")
  currency       String          @db.Char(3)
  idempotencyKey String          @unique @map("idempotency_key")
  createdAt      DateTime        @default(now()) @map("created_at")
  wallet         Wallet          @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([sourceType, sourceId])
  @@map("ledger_entries")
}

model WalletHold {
  id              String            @id @default(uuid()) @db.Uuid
  walletId        String            @map("wallet_id") @db.Uuid
  amountMinor     BigInt            @map("amount_minor")
  currency        String            @db.Char(3)
  status          WalletHoldStatus  @default(ACTIVE)
  reason          String            @db.VarChar(500)
  referenceType   String?           @map("reference_type") @db.VarChar(80)
  referenceId     String?           @map("reference_id") @db.VarChar(160)
  idempotencyKey  String            @unique @map("idempotency_key")
  createdByAdminId String           @map("created_by_admin_id") @db.Uuid
  resolvedByAdminId String?         @map("resolved_by_admin_id") @db.Uuid
  resolvedAt      DateTime?         @map("resolved_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  wallet          Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  events          WalletHoldEvent[]
  createdBy       AdminUser         @relation("WalletHoldCreator", fields: [createdByAdminId], references: [id], onDelete: Restrict)
  resolvedBy      AdminUser?        @relation("WalletHoldResolver", fields: [resolvedByAdminId], references: [id], onDelete: Restrict)

  @@index([walletId, status, createdAt])
  @@index([referenceType, referenceId])
  @@map("wallet_holds")
}

model WalletHoldEvent {
  id             String              @id @default(uuid()) @db.Uuid
  holdId         String              @map("hold_id") @db.Uuid
  eventType      WalletHoldEventType @map("event_type")
  amountMinor    BigInt              @map("amount_minor")
  reason         String              @db.VarChar(500)
  adminId        String              @map("admin_id") @db.Uuid
  idempotencyKey String              @unique @map("idempotency_key")
  createdAt      DateTime            @default(now()) @map("created_at")
  hold           WalletHold          @relation(fields: [holdId], references: [id], onDelete: Restrict)
  admin          AdminUser           @relation(fields: [adminId], references: [id], onDelete: Restrict)

  @@index([holdId, createdAt])
  @@map("wallet_hold_events")
}

model ReferralReward {
  id             String   @id @default(uuid()) @db.Uuid
  beneficiaryId  String   @db.Uuid @map("beneficiary_id")
  sourceUserId   String   @db.Uuid @map("source_user_id")
  sourceEventId  String   @map("source_event_id")
  depth          Int
  amountMinor    BigInt   @map("amount_minor")
  currency       String   @db.Char(3)
  idempotencyKey String   @unique @map("idempotency_key")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([beneficiaryId, sourceEventId, depth])
  @@index([beneficiaryId, createdAt])
  @@map("referral_rewards")
}

model WithdrawalRequest {
  id            String           @id @default(uuid()) @db.Uuid
  walletId      String           @map("wallet_id") @db.Uuid
  amountMinor   BigInt           @map("amount_minor")
  currency      String           @db.Char(3)
  status        WithdrawalStatus @default(REQUESTED)
  reviewedById  String?          @map("reviewed_by_id") @db.Uuid
  payoutReference String?         @map("payout_reference")
  payoutAccountId String?          @map("payout_account_id") @db.Uuid
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")
  wallet        Wallet           @relation(fields: [walletId], references: [id], onDelete: Restrict)
  payoutAccount PayoutAccount?    @relation(fields: [payoutAccountId], references: [id], onDelete: Restrict)
  paymentTransactions PaymentTransaction[]

  @@index([status, createdAt])
  @@index([payoutAccountId])
  @@map("withdrawal_requests")
}

model PayoutAccount {
  id                       String             @id @default(uuid()) @db.Uuid
  userId                   String             @map("user_id") @db.Uuid
  countryCode              String             @map("country_code") @db.Char(2)
  currency                 String             @db.Char(3)
  providerCode             String             @map("provider_code")
  methodCode               String             @map("method_code")
  accountHolder            String             @map("account_holder")
  accountDetailsCiphertext String             @map("account_details_ciphertext") @db.Text
  accountDetailsIv         String             @map("account_details_iv")
  accountDetailsTag        String             @map("account_details_tag")
  maskedAccount            String             @map("masked_account")
  status                   PayoutAccountStatus @default(ACTIVE)
  isDefault                Boolean            @default(false) @map("is_default")
  createdAt                DateTime           @default(now()) @map("created_at")
  updatedAt                DateTime           @updatedAt @map("updated_at")
  user                     User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  withdrawals              WithdrawalRequest[]

  @@index([userId, status, createdAt])
  @@map("payout_accounts")
}

model PaymentProviderConfig {
  id                    String   @id @default(uuid()) @db.Uuid
  providerCode          String   @unique @map("provider_code")
  displayName           String   @map("display_name")
  serviceProviderName   String   @default("") @map("service_provider_name")
  countryCode           String   @default("GLOBAL") @map("country_code")
  methodCode            String   @default("BANK_TRANSFER") @map("method_code")
  supportedChannels     String[] @default([]) @map("supported_channels")
  minimumPayoutMinor    BigInt?  @map("minimum_payout_minor")
  maximumPayoutMinor    BigInt?  @map("maximum_payout_minor")
  apiBaseUrl            String?  @map("api_base_url")
  merchantId            String?  @map("merchant_id")
  environment           String   @default("SANDBOX")
  credentialsCiphertext String?  @map("credentials_ciphertext") @db.Text
  credentialsIv         String?  @map("credentials_iv")
  credentialsTag        String?  @map("credentials_tag")
  webhookSecretCiphertext String? @map("webhook_secret_ciphertext") @db.Text
  webhookSecretIv       String?  @map("webhook_secret_iv")
  webhookSecretTag      String?  @map("webhook_secret_tag")
  enabled               Boolean  @default(false)
  supportedCurrencies   String[] @default([]) @map("supported_currencies")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  transactions          PaymentTransaction[]

  @@map("payment_provider_configs")
}

model PaymentTransaction {
  id                    String                  @id @default(uuid()) @db.Uuid
  userId                String                  @map("user_id") @db.Uuid
  walletId              String?                 @map("wallet_id") @db.Uuid
  withdrawalRequestId   String?                 @map("withdrawal_request_id") @db.Uuid
  providerCode          String                  @map("provider_code")
  flow                  PaymentFlow
  status                PaymentTransactionStatus @default(CREATED)
  amountMinor           BigInt                  @map("amount_minor")
  currency              String                  @db.Char(3)
  idempotencyKey        String                  @unique @map("idempotency_key")
  providerTransactionId String?                 @map("provider_transaction_id")
  providerReference     String?                 @map("provider_reference")
  failureCode           String?                 @map("failure_code")
  failureMessage        String?                 @map("failure_message") @db.Text
  metadata              Json?
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet                Wallet?                 @relation(fields: [walletId], references: [id], onDelete: Restrict)
  withdrawalRequest     WithdrawalRequest?      @relation(fields: [withdrawalRequestId], references: [id], onDelete: Restrict)
  provider              PaymentProviderConfig   @relation(fields: [providerCode], references: [providerCode], onDelete: Restrict)

  @@unique([providerCode, providerTransactionId])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([withdrawalRequestId])
  @@map("payment_transactions")
}

model AiReviewConfig {
  id               String   @id @default("default")
  apiKeyCiphertext String?  @map("api_key_ciphertext") @db.Text
  apiKeyIv         String?  @map("api_key_iv")
  apiKeyTag        String?  @map("api_key_tag")
  baseUrl          String   @default("https://api.openai.com/v1") @map("base_url")
  model            String   @default("gpt-4.1")
  enabled          Boolean  @default(false)
  approveThreshold Float   @default(0.9) @map("approve_threshold")
  rejectThreshold  Float   @default(0.9) @map("reject_threshold")
  systemPrompt     String?  @map("system_prompt") @db.Text
  updatedByAdminId String?  @map("updated_by_admin_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("ai_review_configs")
}

model ObjectStorageConfig {
  id                  String   @id @default("default")
  endpoint            String   @db.Text
  bucket              String
  region              String   @default("auto")
  accessKeyCiphertext String?    @map("access_key_ciphertext") @db.Text
  accessKeyIv         String?    @map("access_key_iv")
  accessKeyTag        String?    @map("access_key_tag")
  secretKeyCiphertext String?    @map("secret_key_ciphertext") @db.Text
  secretKeyIv         String?    @map("secret_key_iv")
  secretKeyTag        String?    @map("secret_key_tag")
  enabled             Boolean  @default(false)
  updatedByAdminId    String?  @map("updated_by_admin_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("object_storage_configs")
}

model AdminUser {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String?      @unique @map("user_id") @db.Uuid
  email        String       @unique
  passwordHash String       @map("password_hash")
  status       AdminStatus  @default(ACTIVE)
  createdAt    DateTime     @default(now()) @map("created_at")
  user         User?        @relation(fields: [userId], references: [id], onDelete: Restrict)
  roles        AdminUserRole[]
  reviews      TaskReview[]
  sessions     AdminSession[]
  importBatches ContactImportBatch[]
  walletHoldsCreated WalletHold[] @relation("WalletHoldCreator")
  walletHoldsResolved WalletHold[] @relation("WalletHoldResolver")
  walletHoldEvents WalletHoldEvent[]

  @@map("admin_users")
}

model AdminSession {
  id          String    @id @default(uuid()) @db.Uuid
  adminUserId String    @map("admin_user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, expiresAt])
  @@map("admin_sessions")
}

model Role {
  id          String       @id @default(uuid()) @db.Uuid
  name        String       @unique
  description String?
  permissions RolePermission[]
  users       AdminUserRole[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model AdminUserRole {
  adminUserId String    @map("admin_user_id") @db.Uuid
  roleId      String    @map("role_id") @db.Uuid
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  role        Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([adminUserId, roleId])
  @@map("admin_user_roles")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}


model RiskRule {
  id             String    @id @default(uuid()) @db.Uuid
  name           String    @db.VarChar(160)
  category       String    @db.VarChar(80)
  impactScore    Int       @default(0) @map("impact_score")
  executionOrder Int       @default(100) @map("execution_order")
  startsAt       DateTime? @map("starts_at")
  endsAt         DateTime? @map("ends_at")
  status         String    @default("DRAFT") @db.VarChar(20)
  description    String?   @db.Text
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([status, executionOrder])
  @@index([category])
  @@map("risk_rules")
}

model AuditEvent {
  id         String   @id @default(uuid()) @db.Uuid
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id") @db.Uuid
  action     String
  targetType String   @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([actorType, actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@map("audit_events")
}

model FinanceReconciliationRun {
  id                String   @id @default(uuid()) @db.Uuid
  triggerType       String   @default("MANUAL") @map("trigger_type") @db.VarChar(30)
  status            String   @default("SUCCESS") @db.VarChar(30)
  checkedCount      Int      @default(0) @map("checked_count")
  exceptionCount    Int      @default(0) @map("exception_count")
  summary           Json?
  items             Json?
  createdByAdminId  String   @map("created_by_admin_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  completedAt       DateTime? @map("completed_at")

  @@index([createdAt])
  @@index([status, createdAt])
  @@map("finance_reconciliation_runs")
}

model MessageTemplate {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(160)
  platform  String   @default("WhatsApp") @db.VarChar(40)
  platformCode String? @map("platform_code") @db.VarChar(40)
  action    String   @default("MESSAGE") @db.VarChar(40)
  content   String   @db.Text
  language  String?  @db.VarChar(40)
  keywords  String?  @db.Text
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([enabled, platform, action])
  @@index([name])
  @@map("message_templates")
}

model TaskConfiguration {
  key       String   @id @db.VarChar(80)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("task_configurations")
}
