# Local development only. Use unique managed secrets in production.
DATABASE_URL="postgresql://wtp_dev:local_only_change_me@localhost:5432/wtp_dev?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-a-different-32-character-random-secret"
API_PORT=3002
# Public website origin. Referral links are generated as WEB_ORIGIN/r/{referralCode}.
# Set this to your deployed website domain (for example https://your-domain.com).
WEB_ORIGIN="http://localhost:3000"
ADMIN_ORIGIN="http://localhost:3001"
API_INTERNAL_URL="http://127.0.0.1:3002"
# Set a unique random value (32+ characters) before the first administrator bootstrap.
ADMIN_BOOTSTRAP_TOKEN="replace-with-a-unique-random-admin-bootstrap-token"
STORAGE_ENDPOINT=""
STORAGE_BUCKET=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_REGION="auto"
# AES-256-GCM key: Base64 encoding of exactly 32 random bytes. Keep it private and stable.
AI_CONFIG_ENCRYPTION_KEY="BASE64_ENCODED_32_BYTE_KEY"
# Set false to pause the background AI review worker.
AI_REVIEW_WORKER_ENABLED=false
# Evidence objects are private. Use an S3-compatible endpoint such as Cloudflare R2.
# Never commit real access keys or paste them into chat.

# AES-256-GCM key for encrypting admin-managed object storage credentials (Base64 of 32 random bytes)
STORAGE_CONFIG_ENCRYPTION_KEY=

# AES-256-GCM key for encrypting user payout account details (64 hexadecimal characters)
PAYOUT_DATA_ENCRYPTION_KEY=

# AES-256-GCM key for payment provider API credentials (64 hexadecimal characters)
FINANCE_CREDENTIALS_KEY=replace-with-64-hex-characters
